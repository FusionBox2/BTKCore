set(LibSum_VERSION @PROJECT_VERSION@)

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/@TARGETS_EXPORT_NAME@.cmake")

# Alias for either shared or static library
if(NOT TARGET @PROJECT_NAME@::LibSum)
  add_library(@PROJECT_NAME@::LibSum ALIAS @PROJECT_NAME@::LibSum)
endif()

#set_and_check(LibSum_INCLUDE_DIR "@PACKAGE_INCLUDE_INSTALL_DIR@")
#set_and_check(LibSum_SYSCONFIG_DIR "@PACKAGE_SYSCONFIG_INSTALL_DIR@")

check_required_components(LibSum)
